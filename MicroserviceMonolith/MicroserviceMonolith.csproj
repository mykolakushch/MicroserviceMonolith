<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<AssemblyName>MicroserviceMonolith</AssemblyName>
		<RootNamespace>MicroserviceMonolith</RootNamespace>
		<PackageId>MicroserviceMonolith</PackageId>
		<Version>1.4.0</Version>
		<Authors>Mykola Kusch</Authors>
		<Company>mnml</Company>
		<Description>MicroserviceMonolith is a lightweight modular monolith framework for .NET. It provides modules with lifecycle management, in-memory command and query buses (CQRS), an event bus with sequential, parallel and background dispatch strategies, pipeline middlewares (logging, retry, error handling, performance tracking), a background execution queue, an in-memory outbox reference implementation, and Microsoft.Extensions.DependencyInjection integration.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/mykolakushch/MicroserviceMonolith</RepositoryUrl>
		<PackageProjectUrl>https://github.com/mykolakushch/MicroserviceMonolith</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>modular-monolith;cqrs;event-bus;outbox;microservices;architecture;mediator;ddd</PackageTags>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" />
	</ItemGroup>
</Project>
